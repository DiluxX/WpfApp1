<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новостной портал - Вход" 
        Height="500" Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F4F6F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#1565C0" Padding="20,5">
            <StackPanel>
                <TextBlock Text="📰 НОВОСТНОЙ ПОРТАЛ"
                           Foreground="White" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Войдите в систему или продолжите как гость"
                           Foreground="#B3D4FF" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Форма -->
        <Border Grid.Row="1" Background="White" Margin="40,30" CornerRadius="12"
                BorderBrush="#E8EDF2" BorderThickness="1">
            <StackPanel Margin="32,28">

                <TextBlock Text="Вход в систему" FontSize="18" FontWeight="Bold"
                           Foreground="#1A237E" Margin="0,0,0,10"/>

                <!-- Логин -->
                <TextBlock Text="Имя пользователя" FontSize="12" Foreground="#78909C" Margin="0,0,0,5"/>
                <Border BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                    <TextBox x:Name="UsernameTextBox"
                             Height="36" FontSize="14" BorderThickness="0"
                             Padding="10,0" VerticalContentAlignment="Center"
                             KeyDown="UsernameTextBox_KeyDown"/>
                </Border>

                <!-- Пароль -->
                <TextBlock Text="Пароль" FontSize="12" Foreground="#78909C" Margin="0,0,0,5"/>
                <Border BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                    <PasswordBox x:Name="PasswordBox"
                                 Height="36" FontSize="14" BorderThickness="0"
                                 Padding="10,0"
                                 KeyDown="PasswordBox_KeyDown"/>
                </Border>

                <!-- Ошибка -->
                <TextBlock x:Name="ErrorTextBlock" Foreground="#EF5350"
                           FontSize="12" TextWrapping="Wrap"
                           Margin="0,0,0,12" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Кнопка входа -->
                <Button x:Name="LoginButton" Content="Войти"
                        Height="42" FontSize="14" FontWeight="Bold"
                        Background="#1565C0" Width="100" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="LoginButton_Click" Margin="0,0,30,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Гостевой вход -->
                <Button x:Name="GuestButton" Content="Войти как гость"
                        Height="42" FontSize="13" Width="100"
                        Background="Transparent" Foreground="#546E7A"
                        BorderBrush="#D0D7DE" BorderThickness="1"
                        Cursor="Hand" Click="GuestButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Футер -->
        <Border Grid.Row="2" Padding="10,8">
            <TextBlock Text="Для добавления комментариев и управления контентом требуется авторизация"
                       HorizontalAlignment="Center" FontSize="11" Foreground="#90A4AE"/>
        </Border>
    </Grid>
</Window>
