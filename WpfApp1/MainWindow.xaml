<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новостной портал - Вход" 
        Height="424" Width="617"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2196F3" Padding="15">
            <TextBlock Text="Новостной портал" 
                       Foreground="White" 
                       FontSize="24" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Основное содержание -->
        <Grid Grid.Row="1" Margin="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Панель входа -->
            <Border Grid.Column="0" 
                    BorderBrush="LightGray" 
                    BorderThickness="0,0,1,0"
                    Padding="20" Margin="0,0,0,-25">
                <StackPanel>

                    <TextBlock Text="Вход в систему" 
                               FontSize="20" 
                               FontWeight="Bold"
                               />

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Имя пользователя:" 
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="UsernameTextBox" 
                                 Height="30" 
                                 FontSize="14"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Пароль:" 
                                   Margin="0,0,0,5"/>
                        <PasswordBox x:Name="PasswordBox" 
                                     Height="30" 
                                     FontSize="14"/>
                    </StackPanel>
                    <Button x:Name="LoginButton" 
                            Content="Войти" 
                            Height="35" 
                            FontSize="14"
                            Click="LoginButton_Click"/>

                    <TextBlock x:Name="ErrorTextBlock" 
                               Foreground="Red" 
                               TextWrapping="Wrap"
                               Height="26" 
                               Margin="0,0,0,10"/>
                </StackPanel>
            </Border>

            <!-- Панель гостя -->
            <Border 
                    Padding="20" Grid.ColumnSpan="2" Margin="268,0,0,-25">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Гостевой доступ" 
                               FontSize="20" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Вы можете просматривать новости без регистрации" 
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,30"/>

                    <Button x:Name="GuestButton" 
                            Content="Войти как гость" 
                            Height="35" 
                            FontSize="14"
                            Click="GuestButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Нижняя панель -->
        <Border Grid.Row="1" 
                Background="#F5F5F5" 
                Padding="10" Margin="0,311,0,0">
            <TextBlock Text="Для добавления комментариев и управления контентом требуется авторизация" 
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>