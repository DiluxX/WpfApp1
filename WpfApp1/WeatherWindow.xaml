<Window x:Class="WpfApp1.WeatherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Погода" Height="550" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#F4F6F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#1565C0" Padding="15">
            <StackPanel>
                <TextBlock Text="ПОГОДА" Foreground="White" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="CityTextBlock" Foreground="#B3D4FF" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel x:Name="ContentPanel">
                <ProgressBar x:Name="LoadingProgress" IsIndeterminate="True" Height="4" Margin="0,0,0,20"/>

                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15"
                        Visibility="Collapsed" x:Name="WeatherCard">
                    <StackPanel>
                        <!-- Температура и иконка -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image x:Name="WeatherIcon" Grid.Column="0" Width="64" Height="64" Margin="0,0,15,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TempTextBlock" FontSize="36" FontWeight="Bold" Foreground="#1A237E"/>
                                <TextBlock x:Name="DescriptionTextBlock" FontSize="14" Foreground="#546E7A"/>
                            </StackPanel>
                        </Grid>

                        <!-- Ощущается как -->
                        <TextBlock x:Name="FeelsLikeTextBlock" FontSize="13" Foreground="#78909C" Margin="0,0,0,15"/>

                        <!-- Детали -->
                        <Border Background="#F8F9FA" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="💧 " FontSize="14"/>
                                    <TextBlock Text="Влажность:" Foreground="#78909C"/>
                                    <TextBlock x:Name="HumidityTextBlock" FontWeight="SemiBold" Margin="5,0,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="🌡️ " FontSize="14"/>
                                    <TextBlock Text="Давление:" Foreground="#78909C"/>
                                    <TextBlock x:Name="PressureTextBlock" FontWeight="SemiBold" Margin="5,0,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="💨 " FontSize="14"/>
                                    <TextBlock Text="Ветер:" Foreground="#78909C"/>
                                    <TextBlock x:Name="WindTextBlock" FontWeight="SemiBold" Margin="5,0,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="🧭 " FontSize="14"/>
                                    <TextBlock Text="Направление:" Foreground="#78909C"/>
                                    <TextBlock x:Name="WindDirTextBlock" FontWeight="SemiBold" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorTextBlock" Foreground="Red" TextWrapping="Wrap" 
                           HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Нижняя панель -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E8EDF2" BorderThickness="0,1,0,0" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" Content="← Назад" 
                        Width="100" Height="35"
                        Click="BackButton_Click"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#2196F3" Cursor="Hand"/>
                <Button x:Name="RefreshButton" Grid.Column="1" Content="🔄 Обновить"
                        Width="100" Height="35"
                        Click="RefreshButton_Click"
                        Background="#2196F3" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        />
            </Grid>
        </Border>
    </Grid>
</Window>