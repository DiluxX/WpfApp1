<Window x:Class="WpfApp1.RegionSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор местности" Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Стиль карточки региона -->
        <Style x:Key="RegionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="#E8EDF2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F7FF"/>
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль активной карточки региона -->
        <Style x:Key="ActiveRegionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#E3F2FD"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="#2196F3"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Стиль поиска -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Placeholder" Text="Поиск города..." 
                                           Foreground="#90A4AE" Margin="12,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2196F3"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль кнопки действия -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль вторичной кнопки -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F4F6F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#1565C0" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFFFFF22" CornerRadius="8" Padding="10,6" Margin="0,0,14,0">
                        <TextBlock Text="&#x1F3D9;" FontSize="22" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ВЫБОР МЕСТНОСТИ" 
                                   Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Выберите город для отображения локальных новостей" 
                                   Foreground="#B3D4FF" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UserGreetingTextBlock" 
                               Text="" 
                               Foreground="#B3D4FF" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border Background="#FF008BE4" CornerRadius="12" Padding="10,4"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="RoleTextBlock" Text="" 
                                   Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основное содержание -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: поиск и список регионов -->
            <Border Grid.Column="0" Background="White" 
                    BorderBrush="#E8EDF2" BorderThickness="0,0,1,0"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок панели -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="ГОРОДА" FontSize="10" FontWeight="Bold" 
                                   Foreground="#90A4AE" Margin="0,0,0,8"/>
                        <TextBox x:Name="SearchTextBox" 
                                 Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="SearchTextBox_TextChanged"/>
                    </StackPanel>

                    <!-- Счетчик -->
                    <TextBlock Grid.Row="1" x:Name="RegionsCountTextBlock"
                               Text="Загрузка..." 
                               FontSize="11" Foreground="#90A4AE"
                               Margin="0,0,0,10"/>

                    <!-- Список регионов -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RegionsPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Правая панель: детали выбранного региона -->
            <Grid Grid.Column="1" Background="#F4F6F9">

                <!-- Заглушка когда ничего не выбрано -->
                <StackPanel x:Name="EmptyDetailPanel" 
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Visible">
                    <TextBlock Text="&#x1F5FA;" FontSize="64" HorizontalAlignment="Center" Opacity="0.25"/>
                    <TextBlock Text="Выберите город" 
                               FontSize="16" Foreground="#B0BEC5"
                               HorizontalAlignment="Center" Margin="0,14,0,6"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="для просмотра локальных новостей" 
                               FontSize="13" Foreground="#CFD8DC"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Детали региона -->
                <ScrollViewer x:Name="RegionDetailsScrollViewer" 
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed"
                              Padding="24">
                    <StackPanel MaxWidth="480" HorizontalAlignment="Center">

                        <!-- Карточка региона -->
                        <Border Background="White" 
                                CornerRadius="12" 
                                Padding="28"
                                BorderBrush="#E8EDF2" BorderThickness="1">
                            <StackPanel>
                                <!-- Иконка и название -->
                                <Border Background="#E3F2FD" 
                                        CornerRadius="12" 
                                        Width="72" Height="72"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,16">
                                    <TextBlock x:Name="RegionIconTextBlock"
                                               Text="&#x1F3D9;" 
                                               FontSize="36"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock x:Name="SelectedRegionNameTextBlock"
                                           Text="" 
                                           FontSize="22" 
                                           FontWeight="Bold"
                                           Foreground="#1A237E"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,6"/>

                                <TextBlock x:Name="SelectedRegionDescriptionTextBlock"
                                           Text="" 
                                           FontSize="13"
                                           Foreground="#78909C"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,20"/>

                                <!-- Информация -->
                                <Border Background="#F8F9FA" 
                                        CornerRadius="8" 
                                        Padding="16"
                                        Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="&#x1F4CD; " FontSize="13"/>
                                            <TextBlock Text="Регион: " FontSize="12" Foreground="#78909C"/>
                                            <TextBlock x:Name="RegionAreaTextBlock" 
                                                       Text="" FontSize="12" 
                                                       Foreground="#424242" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="&#x1F3C6; " FontSize="13"/>
                                            <TextBlock Text="Население: " FontSize="12" Foreground="#78909C"/>
                                            <TextBlock x:Name="RegionPopulationTextBlock" 
                                                       Text="" FontSize="12" 
                                                       Foreground="#424242" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <TextBlock Text="&#x23F0; " FontSize="13"/>
                                            <TextBlock Text="Часовой пояс: " FontSize="12" Foreground="#78909C"/>
                                            <TextBlock x:Name="RegionTimezoneTextBlock" 
                                                       Text="" FontSize="12" 
                                                       Foreground="#424242" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Кнопки действий -->
                                <Button x:Name="ConfirmRegionButton"
                                        Content="&#x2705; Подтвердить выбор"
                                        Click="ConfirmRegionButton_Click"
                                        Background="#2196F3"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Height="44"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Margin="0,0,0,10"
                                        Style="{StaticResource ActionButtonStyle}"/>

                                <Button x:Name="ClearSelectionButton"
                                        Content="Отменить выбор"
                                        Click="ClearSelectionButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
