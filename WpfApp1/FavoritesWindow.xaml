<Window x:Class="WpfApp1.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="FavoritesWindow" Height="450" Width="800">
    <Window.Resources>
        <Style x:Key="FavCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="#E8EDF2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF8F0"/>
                    <Setter Property="BorderBrush" Value="#FF9800"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SelectedFavCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF3E0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="#FF9800"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F4F6F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#1565C0" Padding="16,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⭐ ИЗБРАННОЕ" Foreground="White"
                               FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="#FFFFFF22" CornerRadius="10" Padding="8,2" Margin="12,0,0,0">
                        <TextBlock x:Name="CountTextBlock" Text="0 статей"
                                   Foreground="White" FontSize="11"/>
                    </Border>
                </StackPanel>
                <Button Content="✕ Закрыть" HorizontalAlignment="Right"
                        Click="CloseButton_Click"
                        Background="Transparent" BorderThickness="0"
                        Foreground="White" Cursor="Hand" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Содержимое -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Список избранных -->
            <Border Grid.Column="0" Background="White"
                    BorderBrush="#E8EDF2" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8F9FA"
                            BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="14,10">
                        <TextBlock Text="Сохранённые статьи" FontSize="13"
                                   FontWeight="SemiBold" Foreground="#37474F"/>
                    </Border>

                    <!-- Заглушка если список пуст -->
                    <StackPanel x:Name="EmptyPanel" Grid.Row="1"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Visible">
                        <TextBlock Text="⭐" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
                        <TextBlock Text="Нет избранных статей"
                                   FontSize="14" Foreground="#B0BEC5"
                                   HorizontalAlignment="Center" Margin="0,10,0,4"/>
                        <TextBlock Text="Добавьте статьи из ленты новостей"
                                   FontSize="12" Foreground="#CFD8DC"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer x:Name="FavScrollViewer" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="12" Visibility="Collapsed">
                        <StackPanel x:Name="FavListPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Детали + комментарии -->
            <Grid Grid.Column="1" Background="#F4F6F9">

                <!-- Заглушка -->
                <StackPanel x:Name="NoSelectionPanel"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Visible">
                    <TextBlock Text="📝" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="Выберите статью"
                               FontSize="14" Foreground="#B0BEC5"
                               HorizontalAlignment="Center" Margin="0,10,0,4"/>
                    <TextBlock Text="для просмотра и комментариев"
                               FontSize="12" Foreground="#CFD8DC"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Панель деталей -->
                <Grid x:Name="DetailPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок статьи -->
                    <Border Grid.Row="0" Background="White"
                            BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="16,12">
                        <StackPanel>
                            <TextBlock x:Name="DetailTitleTextBlock"
                                       FontSize="15" FontWeight="Bold" Foreground="#1A237E"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="#E3F2FD" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock x:Name="DetailCategoryTextBlock"
                                               FontSize="10" FontWeight="Bold" Foreground="#1565C0"/>
                                </Border>
                                <TextBlock x:Name="DetailSourceTextBlock"
                                           FontSize="11" Foreground="#78909C" VerticalAlignment="Center"/>
                                <TextBlock Text=" · " Foreground="#BDBDBD" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DetailDateTextBlock"
                                           FontSize="11" Foreground="#B0BEC5" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="OpenUrlButton" Content="🔗 Читать"
                                        Height="28" Padding="10,0"
                                        Click="OpenUrlButton_Click"
                                        Background="#1565C0" Foreground="White"
                                        BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>
                                <Button x:Name="RemoveFavButton" Content="🗑 Удалить из избранного"
                                        Height="28" Padding="10,0"
                                        Click="RemoveFavButton_Click"
                                        Background="#EF5350" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Комментарии -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>
                            <TextBlock Text="КОММЕНТАРИИ" FontSize="10" FontWeight="Bold"
                                       Foreground="#90A4AE" Margin="0,0,0,10"/>
                            <StackPanel x:Name="CommentsPanel"/>
                            <TextBlock x:Name="NoCommentsText" Text="Комментариев пока нет. Будьте первым!"
                                       FontSize="12" Foreground="#B0BEC5" Margin="0,8,0,0"
                                       Visibility="Visible"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Поле добавления комментария -->
                    <Border Grid.Row="2" Background="White"
                            BorderBrush="#E8EDF2" BorderThickness="0,1,0,0" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Добавить комментарий" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#37474F" Margin="0,0,0,6"/>
                            <Border BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                                <TextBox x:Name="NewCommentTextBox"
                                         Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="10" BorderThickness="0" FontSize="13"/>
                            </Border>
                            <Button Content="Отправить комментарий"
                                    Height="34" HorizontalAlignment="Left" Padding="16,0"
                                    Click="AddCommentButton_Click"
                                    Background="#4CAF50" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>